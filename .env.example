# LedgerGuard Environment Configuration Template
# Copy this file to .env in backend/ or root for local development. Never commit real secrets.

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication (Security Module - Srabani)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_dev
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_refresh_key_at_least_32_characters_long_for_dev
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# RSA Signature Verification (Security Module - Srabani)
# Algorithm: RSA-PSS with SHA-256 (2048-bit PEM)
RSA_TIMESTAMP_TOLERANCE_SECONDS=300

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Database Configuration (Aniket)
MONGODB_URI=mongodb://localhost:27017/ledgerguard_master

# Redis Configuration (Purnima)
REDIS_URL=redis://localhost:6379
